# Скопируйте в .env и заполните. Файл .env не должен попадать в git и в веб-корень.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=twofa
DB_USER=twofa
DB_PASS=change-me

# Логин администратора. ADMIN_PASSWORD — либо обычный пароль,
# либо хеш от password_hash() (начинается с $2y$ или $argon2).
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-too

# Ключ шифрования секретов в БД (минимум 32 символа, случайный).
# Сгенерировать: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# ВНИМАНИЕ: при смене ключа уже сохранённые секреты станут нечитаемыми.
APP_KEY=

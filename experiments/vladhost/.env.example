# Скопируйте в .env (make env сгенерирует секрет).
VLADHOST_ADDR=127.0.0.1:8090
VLADHOST_DATABASE_URL=postgres://vladhost:vladhost@127.0.0.1:5433/vladhost?sslmode=disable
VLADHOST_TEST_DATABASE_URL=postgres://vladhost:vladhost@127.0.0.1:5433/vladhost?sslmode=disable
VLADHOST_JWT_SECRET=__GENERATED__
# В dev по http cookie без Secure; на бою — true (по умолчанию).
VLADHOST_COOKIE_SECURE=false
# FTPS (только с TLS). Без VLADHOST_FTP_CERT/KEY создаётся временный самоподписанный сертификат (только dev).
# Проверка: lftp -u blog.имя,пароль -e "set ftp:ssl-force true; set ssl:verify-certificate no" 127.0.0.1:2121
VLADHOST_FTP_ADDR=127.0.0.1:2121
VLADHOST_FTP_PUBLIC_IP=127.0.0.1
VLADHOST_FTP_PASSIVE_PORTS=42000-42050

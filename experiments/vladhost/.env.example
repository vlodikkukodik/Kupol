# Скопируйте в .env (make env сгенерирует секрет).
VLADHOST_ADDR=127.0.0.1:8090
VLADHOST_DATABASE_URL=postgres://vladhost:vladhost@127.0.0.1:5433/vladhost?sslmode=disable
VLADHOST_TEST_DATABASE_URL=postgres://vladhost:vladhost@127.0.0.1:5433/vladhost?sslmode=disable
VLADHOST_TEST_MARIADB_ADDR=127.0.0.1:3307
VLADHOST_JWT_SECRET=__GENERATED__
# В dev по http cookie без Secure; на бою — true (по умолчанию).
VLADHOST_COOKIE_SECURE=false
# FTPS (только с TLS). Без VLADHOST_FTP_CERT/KEY создаётся временный самоподписанный сертификат (только dev).
# Проверка: lftp -u blog.имя,пароль -e "set ftp:ssl-force true; set ssl:verify-certificate no" 127.0.0.1:2121
VLADHOST_FTP_ADDR=127.0.0.1:2121
VLADHOST_FTP_PUBLIC_IP=127.0.0.1
VLADHOST_FTP_PASSIVE_PORTS=42000-42050
# Резервные копии: ежедневные снимки сайтов (хранятся 7 дней). Пусто — раздел выключен.
VLADHOST_BACKUP_DIR=/data/vladhost/backups
# Почта (подтверждение адреса, сброс пароля, уведомления). Без SMTP-сервера эти возможности выключены.
# Например, smtp.majordomo.ru: порт 587 (STARTTLS) или 465 (tls); логин и пароль — от почтового ящика отправителя.
# Проверка на сервере: /opt/vladhost/bin/vladhost mail-test --to you@example.com
# VLADHOST_SMTP_HOST=smtp.majordomo.ru
# VLADHOST_SMTP_PORT=587
# VLADHOST_SMTP_TLS=starttls
# VLADHOST_SMTP_USER=noreply@vladinc.ru
# VLADHOST_SMTP_PASSWORD=
# VLADHOST_SMTP_FROM=noreply@vladinc.ru
# VLADHOST_SMTP_FROM_NAME=Vladhost
# Для разработки без SMTP письма можно складывать файлами .eml:
# VLADHOST_MAIL_SPOOL=/tmp/vh-mail

# Базы данных пользователей (раздел «Базы данных»): отдельный кластер PostgreSQL (порт 5433) и MariaDB. deploy/prepare-db.sh
# ставит всё на сервере и дописывает эти переменные в /etc/vladhost/env сам.
# VLADHOST_DB_PG_ADMIN_URL=postgres://vhadmin:пароль@127.0.0.1:5433/postgres?sslmode=disable
# VLADHOST_DB_PG_HBA_DIR=/etc/postgresql/16/vladhost/hba.d
# VLADHOST_DB_MARIADB_ADMIN_DSN=vhadmin:пароль@tcp(127.0.0.1:3306)/
# VLADHOST_DB_MARIADB_EXTERNAL=true
# VLADHOST_DB_HOST=db.vladinc.ru
# VLADHOST_DB_WEB_URL=https://db.vladinc.ru
# VLADHOST_DB_INTERNAL_KEY=   # не короче 32 символов: общий секрет панели и Adminer
# VLADHOST_DB_PER_ENGINE=3
# VLADHOST_DB_SIZE_MB=100

# SSH и веб-терминал: SSH принимает сама панель (порт 2222), оболочки запускает посредник от root (vladhost-shell.service).
# deploy/prepare-ssh.sh дописывает переменные сам. Пустой VLADHOST_SHELL_SOCKET выключает раздел, пустой VLADHOST_SSH_ADDR — только внешний SSH.
# VLADHOST_SHELL_SOCKET=/run/vladhost/shell.sock
# VLADHOST_SSH_ADDR=:2222
# VLADHOST_SSH_HOST=ssh.vladinc.ru
# VLADHOST_SSH_HOST_KEY=/data/vladhost/ssh/host_ed25519

# Собственный DNS (ns.vladinc.ru и ns2.vladinc.ru на одном IP): deploy/prepare-dns.sh дописывает переменную сам. Пусто — раздел «DNS» выключен.
# VLADHOST_DNS_NS=ns.vladinc.ru,ns2.vladinc.ru

# Почта на своих доменах (ящики, алиасы, DKIM): deploy/prepare-mail.sh дописывает переменные сам. Пустой VLADHOST_MAIL_HOST выключает раздел «Почта».
# VLADHOST_MAIL_HOST=mail.vladinc.ru
# VLADHOST_MAIL_SERVER_IP=203.0.113.10
# Webmail (Roundcube): deploy/prepare-webmail.sh дописывает адрес сам; пусто — кнопки «Открыть webmail» нет.
# VLADHOST_WEBMAIL_URL=https://webmail.vladinc.ru

# Установка приложений (WordPress в один клик): нужны среды выполнения и MariaDB. deploy/prepare-cms.sh дописывает переменные сам.
# VLADHOST_CMS_CACHE_DIR=/data/vladhost/cache/cms
# VLADHOST_GATEWAY_URL=http://127.0.0.1:8091
# Свой каталог приложений (версия, адрес, sha256) вместо встроенного:
# VLADHOST_CMS_CATALOG=/etc/vladhost/cms-catalog.json

# Среды выполнения сайтов (PHP, Node.js, Python). deploy/prepare-runtime.sh ставит всё и дописывает переменную сам.
# VLADHOST_RUNTIME_DIR=/var/lib/vladhost/runtime
# Веб-шлюз: каталог сокетов пулов PHP-FPM.
# VLADHOST_PHP_SOCKET_DIR=/run/vhphp

# Планировщик задач. HTTP-задачи работают всегда; команды в песочнице сайта — только если заданы папки обмена с исполнителем
# от root (deploy/prepare-cron.sh создаёт их и дописывает переменные).
# VLADHOST_CRON_QUEUE=/var/lib/vladhost/cron/queue
# VLADHOST_CRON_RESULTS=/var/lib/vladhost/cron/results
# VLADHOST_CRON_MAX_JOBS=5
# VLADHOST_CRON_MIN_INTERVAL_MIN=5
# VLADHOST_CRON_TIMEOUT_SEC=60

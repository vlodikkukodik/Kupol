[Unit]
Description=Vladhost — панель и API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=vladhost
Group=vladhost
EnvironmentFile=/etc/vladhost/env
ExecStart=/opt/vladhost/bin/vladhost serve
Restart=on-failure
RestartSec=3

# Панель не root и почти ничего не может писать: только файлы сайтов и свою папку заявок.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# Каталог правил доступа отдельного кластера PostgreSQL для баз пользователей (создаёт prepare-db.sh; «-» — если его нет).
ReadWritePaths=/data/vladhost /var/lib/vladhost/certs/queue -/etc/postgresql/16/vladhost/hba.d
# Заявки на запуск команд планировщика (создаёт prepare-cron.sh); результаты панель только читает.
ReadWritePaths=-/var/lib/vladhost/cron/queue -/var/lib/vladhost/runtime/queue

[Install]
WantedBy=multi-user.target

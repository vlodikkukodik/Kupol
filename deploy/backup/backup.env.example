# /etc/kupol/backup.env — настройки ночной копии (права 600, владелец — пользователь kupol).
# Образец; боевой файл в git не попадает.

# Подключение к БД (то же, что в /etc/kupol/kupol.env).
KUPOL_DATABASE_URL=postgres://kupol:ПАРОЛЬ@127.0.0.1:5432/kupol?sslmode=disable

# ПУБЛИЧНЫЙ ключ age (age1…). Приватный ключ хранится только у автора, на VPS его быть не должно:
#   age-keygen -o kupol-backup.key      # приватный — в менеджер паролей и на второй носитель
#   age-keygen -y kupol-backup.key      # печатает публичный ключ — его сюда
AGE_RECIPIENT=age1...

BACKUP_DIR=/var/backups/kupol
KEEP_LOCAL=14

# Копия на другую машину (shared-хостинг) по FTPS. Каталог — ВНЕ веб-каталога сайта (не внутри www!).
# Лучше завести на хостинге отдельного FTP-пользователя только для копий.
FTP_HOST=web16.majordomo.ru
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_BACKUP_DIR=kupol.vladinc.ru/backups
FTP_TLS=explicit
FTP_VERIFY_CERT=yes
KEEP_REMOTE=14

# Необязательно: адрес пинга внешнего монитора (Healthchecks.io) — если копия не сделана, придёт тревога.
HEALTHCHECK_URL=

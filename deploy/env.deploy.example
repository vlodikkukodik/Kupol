# Настройки деплоя. Скопируйте в deploy/.env.deploy (этот файл в git не попадает) и заполните.
# Реальные значения лежат в docs/secrets.local.md.

# --- фронтенд: FTP на shared-хостинг (deploy-front.sh) ---
FTP_HOST=ftp.example.com
FTP_PORT=21
FTP_USER=changeme
FTP_PASSWORD=changeme
# Каталог сайта на хостинге (путь от корня FTP). У kupol.vladinc.ru это kupol.vladinc.ru/www.
# Всё, что там лежит сейчас, при первом деплое будет удалено (только с флагом --wipe, после показа списка).
FTP_REMOTE_DIR=kupol.vladinc.ru/www
# explicit — FTP поверх TLS (рекомендуется), none — без шифрования
FTP_TLS=explicit
# no — только если у хостинга самоподписанный сертификат FTP
FTP_VERIFY_CERT=yes
SITE_URL=https://kupol.vladinc.ru

# --- бэкенд: SSH на VPS (deploy-back.sh) ---
VPS_HOST=api.kupol.vladinc.ru
VPS_PORT=22
VPS_USER=deploy
# Каталог с бинарником на VPS
VPS_DIR=/opt/kupol
# Как перезапустить сервис (пользователь deploy должен иметь на это sudo без пароля, см. docs/deploy.md)
VPS_RESTART_CMD="sudo systemctl restart kupol"
# Откуда на VPS проверять, что API поднялся (адрес из KUPOL_HTTP_ADDR; 8080 на боевом VPS занят Apache)
VPS_HEALTH_URL=http://127.0.0.1:8081/health
# Публичный адрес API для итоговой проверки с вашей машины
API_URL=https://api.kupol.vladinc.ru

# /etc/kupol/kupol.env — настройки Go API на VPS. Права: chown root:root, chmod 600.
# Образец; реальные значения не коммитить.

KUPOL_ENV=prod
KUPOL_LOG_LEVEL=info

# PostgreSQL на этом же VPS. Пароль: openssl rand -hex 24
KUPOL_DATABASE_URL=postgres://kupol:ПАРОЛЬ@127.0.0.1:5432/kupol?sslmode=disable

# Слушаем только loopback — наружу API отдаёт nginx (deploy/server/nginx-kupol-api.conf).
# На боевом VPS порт 8080 занят Apache, поэтому 8081.
KUPOL_HTTP_ADDR=127.0.0.1:8081

# Общий секрет с PHP-прокси (api/config.php на хостинге, поле 'secret'). Генерация: openssl rand -hex 32
KUPOL_PROXY_SECRET=

# nginx стоит перед Go на этой же машине — ему доверяем X-Forwarded-For
KUPOL_TRUSTED_PROXIES=127.0.0.1

# ОБЯЗАТЕЛЬНО в prod: origin сайта (схема://хост, без пути и слеша). Изменяющие запросы (вход,
# регистрация, смена пароля...) принимаются только с этим Origin — защита от CSRF.
# Без него API не запустится.
KUPOL_SITE_ORIGIN=https://kupol.vladinc.ru

# Лимиты частоты по умолчанию — из спецификации (вход 5 неудач/15 мин на IP+логин, 15 на логин,
# регистрация 3/час на IP, API 120/мин). Переопределять не нужно; при необходимости:
# KUPOL_LIMIT_LOGIN_ATTEMPTS=5
# KUPOL_LIMIT_LOGIN_LOCK_ATTEMPTS=15
# KUPOL_LIMIT_REGISTER_PER_HOUR=3
# KUPOL_LIMIT_API_PER_MINUTE=120

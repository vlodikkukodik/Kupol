# /etc/systemd/system/kupol.service — Go API проекта КУПОЛ на VPS.
# Установка: см. docs/deploy.md, «Подготовка VPS».
[Unit]
Description=КУПОЛ — Go API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=kupol
Group=kupol
WorkingDirectory=/opt/kupol
# Секреты и настройки: /etc/kupol/kupol.env (права 600, владелец root) — образец deploy/server/kupol.env.example
EnvironmentFile=/etc/kupol/kupol.env
# Загрузки (этап 6.1) — единственное, куда API пишет на диске. ProtectSystem=strict ниже делает всю
# файловую систему read-only, а каталог рядом с бинарником API и создать не может (/opt/kupol принадлежит
# deploy). Поэтому каталог заводит systemd: /var/lib/kupol появляется при старте с владельцем kupol,
# и туда же указывает KUPOL_UPLOADS_DIR. Вручную ничего создавать не нужно; перекрыть путь можно в
# /etc/kupol/kupol.env (тогда каталог обязан существовать и быть записываемым — иначе API не стартует).
StateDirectory=kupol
StateDirectoryMode=0750
Environment=KUPOL_UPLOADS_DIR=/var/lib/kupol/uploads
ExecStart=/opt/kupol/kupol serve
Restart=on-failure
RestartSec=3
# API завершает запросы по SIGTERM до 20 с (graceful shutdown)
TimeoutStopSec=30
LimitNOFILE=65535

# Ограничения процесса
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true

[Install]
WantedBy=multi-user.target

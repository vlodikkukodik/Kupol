# Скопируйте в .env (make env делает это и генерирует секрет). .env в git не попадает.
KUPOL_ENV=dev
KUPOL_LOG_LEVEL=debug

KUPOL_DB_USER=kupol
KUPOL_DB_PASSWORD=kupol
KUPOL_DB_NAME=kupol
KUPOL_DB_PORT=5432
KUPOL_DATABASE_URL=postgres://kupol:kupol@127.0.0.1:5432/kupol?sslmode=disable
KUPOL_TEST_DATABASE_URL=postgres://kupol:kupol@127.0.0.1:5432/kupol_test?sslmode=disable

# Go API
KUPOL_HTTP_ADDR=127.0.0.1:8080
# Общий секрет PHP-прокси и Go API (HMAC подписи X-Real-IP). >= 32 байт, hex/base64.
KUPOL_PROXY_SECRET=__GENERATED__
# CIDR обратных прокси перед Go (nginx/caddy на VPS), через запятую. Пусто = никому не доверять.
KUPOL_TRUSTED_PROXIES=
# Origin сайта: изменяющие запросы принимаются только с ним (защита от CSRF). В dev — адрес Vite;
# если не задан, scripts/dev.sh подставляет http://127.0.0.1:$KUPOL_FRONT_PORT. В prod обязателен.
# KUPOL_SITE_ORIGIN=http://127.0.0.1:5173

# Лимиты частоты (спецификация §2). Здесь смягчены, чтобы сквозные тесты могли регистрировать
# много пользователей с одного IP. В проде НЕ задавайте — действуют значения по спецификации:
# вход 5 неудач/15 мин на IP+логин, 15 на логин, регистрация 3/час на IP, API 120/мин.
KUPOL_LIMIT_REGISTER_PER_HOUR=1000
KUPOL_LIMIT_API_PER_MINUTE=3000

# PHP-прокси (dev: php -S; в проде эти значения лежат в api/config.php)
KUPOL_PROXY_UPSTREAM=http://127.0.0.1:8080
KUPOL_PROXY_PORT=8081
KUPOL_FRONT_PORT=5173
